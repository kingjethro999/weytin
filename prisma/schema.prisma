generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String?       @unique @db.VarChar(320)
  role               UserRole      @default(user)
  locationId         String?       @map("location_id") @db.Uuid
  businessName       String?       @map("business_name")
  passwordHash       String?       @map("password_hash")
  verificationStatus Verification  @default(pending) @map("verification_status")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplyEntries SupplyEntry[]
  demandEvents  DemandEvent[]
  priceRules    PriceRule[]    @relation("PriceRuleUpdatedBy")
  priceFlags    PriceFlag[]    @relation("PriceFlagReportedBy")

  @@map("profiles")
}

model Location {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(150)
  state         String        @db.VarChar(150)
  lga           String?       @db.VarChar(150)
  lat           Float?
  lng           Float?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  profiles      Profile[]
  supplyEntries SupplyEntry[]
  demandEvents  DemandEvent[]
  priceRules    PriceRule[]
  products      Product[]

  @@map("locations")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(200)
  categoryId  String        @map("category_id") @db.Uuid
  locationId  String?       @map("location_id") @db.Uuid
  unit        String?       @db.VarChar(50)
  approved    Boolean       @default(true)
  suggestedBy String?       @map("suggested_by") @db.VarChar(200)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplyEntries SupplyEntry[]
  demandEvents  DemandEvent[]
  priceRules    PriceRule[]

  @@map("products")
}

model SupplyEntry {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String     @map("product_id") @db.Uuid
  vendorId    String     @map("vendor_id") @db.Uuid
  locationId  String     @map("location_id") @db.Uuid
  quantity    Int
  price       Decimal    @db.Decimal(12, 2)
  submittedAt DateTime   @default(now()) @map("submitted_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor     Profile     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  priceFlags PriceFlag[]

  @@index([productId, locationId, submittedAt])
  @@map("supply_entries")
}

model PriceFlag {
  id            String      @id @default(uuid()) @db.Uuid
  supplyEntryId String      @map("supply_entry_id") @db.Uuid
  reportedBy    String?     @map("reported_by") @db.Uuid
  reason        String      @db.Text
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  supplyEntry SupplyEntry @relation(fields: [supplyEntryId], references: [id], onDelete: Cascade)
  reporter    Profile?    @relation("PriceFlagReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)

  @@index([resolved, createdAt])
  @@map("price_flags")
}

model DemandEvent {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  locationId String        @map("location_id") @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  eventType  DemandType    @map("event_type")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, locationId, createdAt])
  @@map("demand_events")
}

model PriceRule {
  id         String     @id @default(uuid()) @db.Uuid
  productId  String     @map("product_id") @db.Uuid
  locationId String     @map("location_id") @db.Uuid
  minPrice   Decimal    @map("min_price") @db.Decimal(12, 2)
  maxPrice   Decimal    @map("max_price") @db.Decimal(12, 2)
  updatedBy  String     @map("updated_by") @db.Uuid
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  updater  Profile   @relation("PriceRuleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@map("price_rules")
}

enum UserRole {
  user
  vendor
  admin
}

enum Verification {
  pending
  verified
  rejected
}

enum DemandType {
  search
  click
  view
  request
}
